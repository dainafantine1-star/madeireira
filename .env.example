HOST=127.0.0.1
PORT=3000
# Banco Postgres (Supabase). Use a conexão direta, porta 5432.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
# CA do Supabase já versionada em server/certs/supabase-ca.pem.
# Sobrescreva apenas se usar outro provedor com CA privada.
DATABASE_CA_PATH=
# Pool de conexões por instância.
DATABASE_POOL_SIZE=4
# Storage das imagens no Supabase.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=media
UPLOAD_DIR=./storage/uploads
# Production: https://your-domain.example (no trailing slash)
PUBLIC_ORIGIN=http://localhost:3000
# Vercel only: exact origin of the dedicated administration subdomain.
ADMIN_ORIGIN=
NODE_ENV=development
# Encrypted backups: 32 random bytes in base64. Required in production.
BACKUP_KEY=
BACKUP_DIR=./storage/backups
BACKUP_INTERVAL_HOURS=24
# Mount storage from another host/provider here for disaster recovery.
BACKUP_MIRROR_DIR=
# Only trust an exact reverse-proxy peer IP. Leave empty for direct local access.
TRUST_PROXY_IP=
# Docker Compose deployment (configure on the hosting provider):
SITE_DOMAIN=
RELEASE_TAG=local
BACKUP_MIRROR_PATH=
# Only for the admin:create command. Never commit the real .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
