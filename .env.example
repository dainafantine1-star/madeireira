HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./storage/store.sqlite
UPLOAD_DIR=./storage/uploads
# Production: https://your-domain.example (no trailing slash)
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
# Encrypted backups: 32 random bytes in base64. Required in production.
BACKUP_KEY=
BACKUP_DIR=./storage/backups
BACKUP_INTERVAL_HOURS=24
# Mount storage from another host/provider here for disaster recovery.
BACKUP_MIRROR_DIR=
# Only trust an exact reverse-proxy peer IP. Leave empty for direct local access.
TRUST_PROXY_IP=
# Docker Compose deployment (configure on the hosting provider):
SITE_DOMAIN=
RELEASE_TAG=local
BACKUP_MIRROR_PATH=
# Only for the admin:create command. Never commit the real .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
