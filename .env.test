# Banco local para os testes.
# Cada teste usa um schema descartável; nada aqui toca o Supabase de produção.
# Suba o serviço do PostgreSQL local antes de rodar `npm test`.
#
# Este arquivo é carregado por último e sobrescreve o `.env` de produção:
# sem isto os testes rodariam contra o Supabase real e contra um origem
# `localhost` diferente do `127.0.0.1` que os testes usam (403 em todo POST).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_SCHEMA=loja
DATABASE_POOL_SIZE=4
NODE_ENV=test
PUBLIC_ORIGIN=
ADMIN_ORIGIN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
